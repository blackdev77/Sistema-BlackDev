// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1. IDENTITY & ACCESS MANAGEMENT (IAM) & SECURITY
// ============================================================================

model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  passwordHash String
  isActive     Boolean @default(true)
  
  // Security & MFA
  mfaEnabled   Boolean @default(false)
  mfaSecret    String?

  roleId       String
  role         Role    @relation(fields: [roleId], references: [id])

  profile      UserProfile?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Traceability & Security Relations
  sessions                  Session[]
  loginHistory              LoginHistory[]
  activityLogs              ActivityLog[]
  auditLogs                 AuditLog[]
  securityEvents            SecurityEvent[]
  trustedDevices            TrustedDevice[]
  
  // Dual Approval Relations
  deviceRequestsCreated     DeviceApprovalRequest[] @relation("DeviceRequestCreator")
  deviceRequestsApproved    DeviceApprovalRequest[] @relation("DeviceRequestApprover")
  criticalActionsRequested  CriticalActionRequest[] @relation("ActionRequester")
  criticalActionsApproved   CriticalActionRequest[] @relation("ActionApprover")

  // Operational Relations
  assignedTasks             ProjectTask[]
  assignedTickets           SupportTicket[]
  leadInteractions          LeadInteraction[]
  projectComments           ProjectComment[]

  @@map("users")
}

model UserProfile {
  id          String  @id @default(uuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  avatarUrl   String?
  bio         String?
  phoneNumber String?
  jobTitle    String?

  @@map("user_profiles")
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique 
  description String?

  users       User[]
  permissions RolePermission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  action      String  @unique 
  description String?
  module      String

  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// --- Session & Device Fingerprinting ---

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  deviceId     String?
  device       TrustedDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  ipAddress    String?
  userAgent    String?
  expires      DateTime

  @@map("sessions")
}

model TrustedDevice {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  friendlyName String?
  fingerprint  String   @unique
  browser      String?
  os           String?
  ipAddress    String?
  location     String?

  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED, REVOKED, EXPIRED
  expiresAt    DateTime?
  
  approvedById String?
  approvedAt   DateTime?

  sessions     Session[]
  deviceRequests DeviceApprovalRequest[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("trusted_devices")
}

model DeviceApprovalRequest {
  id           String   @id @default(uuid())
  deviceId     String
  device       TrustedDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  
  requestedById String
  requestedBy   User     @relation("DeviceRequestCreator", fields: [requestedById], references: [id])
  
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  
  approvedById String?
  approvedBy   User?    @relation("DeviceRequestApprover", fields: [approvedById], references: [id])
  justification String?

  createdAt    DateTime @default(now())
  resolvedAt   DateTime?

  @@map("device_approval_requests")
}

model CriticalActionRequest {
  id           String   @id @default(uuid())
  
  requestedById String
  requestedBy   User     @relation("ActionRequester", fields: [requestedById], references: [id])
  
  actionType   String   // e.g., 'DELETE_PROJECT', 'CHANGE_ADMIN_ROLE'
  payload      String   // JSON containing what is to be executed
  
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  
  approvedById String?
  approvedBy   User?    @relation("ActionApprover", fields: [approvedById], references: [id])
  justification String?

  createdAt    DateTime @default(now())
  resolvedAt   DateTime?

  @@map("critical_action_requests")
}

// ============================================================================
// 2. TRACEABILITY & AUDIT
// ============================================================================

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  loginAt   DateTime @default(now())
  ipAddress String?
  userAgent String?
  status    String   // 'SUCCESS', 'FAILED', 'MFA_REQUIRED', 'DEVICE_UNTRUSTED'
  reason    String?  

  @@map("login_history")
}

model SecurityEvent {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  eventType   String   // e.g., 'MFA_ENABLED', 'DEVICE_REVOKED', 'PASSWORD_CHANGED'
  description String
  ipAddress   String?
  
  createdAt   DateTime @default(now())

  @@map("security_events")
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String? 
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  action      String 
  module      String 
  entityType  String 
  entityId    String 
  description String 

  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([module])
  @@map("activity_logs")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  action      String 
  entityType  String 
  entityId    String 

  oldValues   String?    
  newValues   String?    

  ipAddress   String?
  timestamp   DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ============================================================================
// 3. COMMERCIAL DOMAIN (CRM)
// ============================================================================

model LeadSource {
  id          String @id @default(uuid())
  name        String @unique // e.g., 'Indicação', 'Google Ads', 'Inbound'
  leads       Lead[]

  @@map("lead_sources")
}

model Lead {
  id          String   @id @default(uuid())
  companyName String
  contactName String
  email       String?
  phone       String?
  city        String?
  status      String   @default("NOVO") 
  potential   String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  urgency     String   @default("MEDIUM")
  value       Float?
  
  sourceId    String?
  source      LeadSource? @relation(fields: [sourceId], references: [id])
  
  interactions LeadInteraction[]
  proposals    Proposal[]
  
  convertedToClientId String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@map("leads")
}

model LeadInteraction {
  id          String   @id @default(uuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  type        String   // 'EMAIL', 'CALL', 'MEETING', 'NOTE'
  notes       String
  date        DateTime @default(now())
  
  @@map("lead_interactions")
}

// ============================================================================
// 4. CLIENTS & COMPANIES DOMAIN
// ============================================================================

model Client {
  id           String   @id @default(uuid())
  legalName    String
  tradeName    String
  document     String?  // CNPJ/CPF
  address      String?
  logoUrl      String?  // URL/Base64 of the company brand logo
  status       String   @default("ACTIVE") 
  tier         String   @default("STANDARD") // STANDARD, VIP, ENTERPRISE

  contacts     ClientContact[]
  proposals    Proposal[]
  projects     Project[]
  contracts    Contract[]
  invoices     Invoice[]
  tickets      SupportTicket[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@map("clients")
}

model ClientContact {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  name        String
  role        String?  
  email       String?
  phone       String?
  whatsapp    String?
  isMain      Boolean  @default(false)
  
  // For Client Portal access
  portalAccess Boolean @default(false)
  passwordHash String?

  @@map("client_contacts")
}

// ============================================================================
// 5. PROPOSALS & CONTRACTS
// ============================================================================

model Proposal {
  id          String   @id @default(uuid())
  title       String
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  
  status      String   @default("DRAFT") // DRAFT, SENT, VIEWED, ACCEPTED, REJECTED
  totalValue  Float
  paymentTerms String?
  validUntil  DateTime?
  
  versions    ProposalVersion[]
  projects    Project[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@map("proposals")
}

model ProposalVersion {
  id          String   @id @default(uuid())
  proposalId  String
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  
  versionNum  Int
  contentJSON String   // Stores the rich content of the proposal
  pdfUrl      String?
  
  createdAt   DateTime @default(now())

  @@map("proposal_versions")
}

model Contract {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  title       String
  value       Float
  status      String   @default("DRAFT") // DRAFT, PENDING_SIGNATURE, SIGNED, EXPIRED, CANCELLED
  documentUrl String?
  
  signedAt    DateTime?
  startsAt    DateTime?
  endsAt      DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@map("contracts")
}

// ============================================================================
// 6. PROJECTS & OPERATIONS
// ============================================================================

model ProjectType {
  id          String    @id @default(uuid())
  name        String    @unique // e.g., 'Website', 'SaaS', 'Mobile App', 'Support Retainer'
  projects    Project[]

  @@map("project_types")
}

model Project {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  proposalId  String?
  proposal    Proposal? @relation(fields: [proposalId], references: [id])
  typeId      String?
  type        ProjectType? @relation(fields: [typeId], references: [id])
  
  name        String
  description String?
  status      String   @default("PLANNING") // PLANNING, EXECUTION, REVIEW, DELIVERED, CANCELLED, ON_HOLD
  progress    Int      @default(0) 
  priority    String   @default("MEDIUM")

  tasks       ProjectTask[]
  milestones  ProjectMilestone[]
  updates     ProjectUpdate[]
  comments    ProjectComment[]
  contracts   Contract[]
  invoices    Invoice[]
  approvals   ClientApproval[]

  startDate   DateTime?
  endDate     DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@map("projects")
}

model ProjectMilestone {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  title       String
  dueDate     DateTime?
  status      String   @default("PENDING") // PENDING, COMPLETED
  
  tasks       ProjectTask[]

  @@map("project_milestones")
}

model ProjectTask {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId String?
  milestone   ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  
  title       String
  description String?
  status      String   @default("TODO") // BACKLOG, TODO, IN_PROGRESS, REVIEW, DONE
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])

  dueDate     DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("project_tasks")
}

model ProjectUpdate {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  content     String
  isPublicToClient Boolean @default(true) // Should show in client portal?

  createdAt   DateTime @default(now())

  @@map("project_updates")
}

model ProjectComment {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  content     String
  
  createdAt   DateTime @default(now())

  @@map("project_comments")
}

model ClientApproval {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  title       String
  description String?
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED_WITH_FEEDBACK
  feedback    String?
  
  requestedAt DateTime @default(now())
  resolvedAt  DateTime?

  @@map("client_approvals")
}

// ============================================================================
// 7. FINANCIAL MODULE
// ============================================================================

model Invoice {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  description String
  amount      Float
  status      String   @default("PENDING") // PENDING, PAID, OVERDUE, CANCELLED
  
  dueDate     DateTime
  paidAt      DateTime?

  payments    Payment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@map("invoices")
}

model Payment {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  amount      Float
  method      String   // PIX, BOLETO, TRANSFER, CREDIT_CARD
  paidAt      DateTime @default(now())

  @@map("payments")
}

model Expense {
  id          String   @id @default(uuid())
  description String
  category    String   @default("OPERACIONAL") // OPERACIONAL, IMPOSTO, FOLHA, INFRAESTRUTURA
  amount      Float
  status      String   @default("PENDING") // PENDING, PAID
  
  dueDate     DateTime
  paidAt      DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@map("expenses")
}

// ============================================================================
// 8. SUPPORT & COMMUNICATION
// ============================================================================

model SupportTicket {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  
  subject     String
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, WAITING_CLIENT, RESOLVED, CLOSED
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  category    String   // BUG, FEATURE_REQUEST, DOUBT, MAINTENANCE
  
  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])

  messages    TicketMessage[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("support_tickets")
}

model TicketMessage {
  id          String   @id @default(uuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  senderType  String   // 'INTERNAL_USER', 'CLIENT'
  senderId    String   // Maps to User.id or ClientContact.id based on senderType
  
  content     String
  
  createdAt   DateTime @default(now())

  @@map("ticket_messages")
}

model Notification {
  id          String   @id @default(uuid())
  userId      String   // Target user
  title       String
  content     String
  link        String?
  isRead      Boolean  @default(false)
  
  createdAt   DateTime @default(now())

  @@map("notifications")
}
